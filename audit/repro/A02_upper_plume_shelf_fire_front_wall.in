&HEAD VERSION = 7700, TITLE = 'Elevated fire igniting inside the upper layer, against a wall' /
!! Audit A02 - upper-layer plume call passes shifted arguments to heskestad_plume (fire.f90:409).
!! Shelf fire (base 2.2 m, above the layer) against the front wall y = 0. Pair with A02_upper_plume_shelf_fire_left_wall.in.
!! Expected: identical results for both files (square room, fire rotated 90 degrees about the room axis).
!! Observed on master at 300 s: HRR_2 = 0 W here, 100 kW for the left-wall file; ULT_1 117.6 C versus 213.9 C.
&TIME SIMULATION = 600 PRINT = 60 SMOKEVIEW = 10 SPREADSHEET = 10 /
&INIT PRESSURE = 101325 RELATIVE_HUMIDITY = 50 INTERIOR_TEMPERATURE = 20 EXTERIOR_TEMPERATURE = 20 /
&MATL ID = 'GYP' MATERIAL = 'Gypsum' CONDUCTIVITY = 0.16 DENSITY = 480 SPECIFIC_HEAT = 1, THICKNESS = 0.016 EMISSIVITY = 0.9 /
&COMP ID = 'Room' DEPTH = 4 HEIGHT = 3 WIDTH = 4 CEILING_MATL_ID = 'GYP' WALL_MATL_ID = 'GYP' FLOOR_MATL_ID = 'GYP' ORIGIN = 0, 0, 0 FLOW_COEFFICIENT = 0 /
&VENT TYPE = 'WALL' ID = 'Door' COMP_IDS = 'Room' 'OUTSIDE', BOTTOM = 0 HEIGHT = 1.2, WIDTH = 1.0 FACE = 'RIGHT' OFFSET = 1.5 /
&FIRE ID = 'Floor fire' COMP_ID = 'Room', FIRE_ID = 'Fuel A' LOCATION = 2.0, 2.0 /
&CHEM ID = 'Fuel A' CARBON = 1 CHLORINE = 0 HYDROGEN = 4 NITROGEN = 0 OXYGEN = 0 HEAT_OF_COMBUSTION = 50000 RADIATIVE_FRACTION = 0.35 /
&TABL ID = 'Fuel A' LABELS = 'TIME', 'HRR', 'HEIGHT', 'AREA' /
&TABL ID = 'Fuel A', DATA = 0, 0, 0, 0.25 /
&TABL ID = 'Fuel A', DATA = 60, 100, 0, 0.25 /
&TABL ID = 'Fuel A', DATA = 600, 100, 0, 0.25 /
&FIRE ID = 'Shelf fire' COMP_ID = 'Room', FIRE_ID = 'Fuel B' LOCATION = 2.0, 0.0 IGNITION_CRITERION = 'TIME' SETPOINT = 120 /
&CHEM ID = 'Fuel B' CARBON = 1 CHLORINE = 0 HYDROGEN = 4 NITROGEN = 0 OXYGEN = 0 HEAT_OF_COMBUSTION = 50000 RADIATIVE_FRACTION = 0.35 /
&TABL ID = 'Fuel B' LABELS = 'TIME', 'HRR', 'HEIGHT', 'AREA' /
&TABL ID = 'Fuel B', DATA = 0, 0, 2.2, 0.25 /
&TABL ID = 'Fuel B', DATA = 30, 100, 2.2, 0.25 /
&TABL ID = 'Fuel B', DATA = 600, 100, 2.2, 0.25 /
&TAIL /
