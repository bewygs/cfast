&HEAD VERSION = 7500, TITLE = 'mech vent negative heights' /
!! Audit A16 - negative mechanical vent HEIGHTS are not converted for the last compartment (input_namelist.f90:1751, 1755).
!! HEIGHTS = -2 in a 3 m room (intended 1.0 m from the floor).
!! Expected: same results as HEIGHTS = 1.0 (ULT_1 53.45 C, HGT_1 0.998 m at 290 s).
!! Observed on master: ULT_1 47.85 C, HGT_1 1.465 m; adding an unconnected second room restores the expected values.
&TIME SIMULATION = 300 PRINT = 60 SMOKEVIEW = 10 SPREADSHEET = 10 /
&INIT /
&MATL ID = 'CONCRETE' MATERIAL = 'Concrete', CONDUCTIVITY = 1.75 DENSITY = 2200 SPECIFIC_HEAT = 1, THICKNESS = 0.15 EMISSIVITY = 0.94 /
&COMP ID = 'Comp 1' DEPTH = 5 HEIGHT = 3 WIDTH = 5 CEILING_MATL_ID = 'CONCRETE' WALL_MATL_ID = 'CONCRETE' FLOOR_MATL_ID = 'CONCRETE' FLOW_COEFFICIENT = 0 /
&VENT TYPE = 'WALL' ID = 'Door' COMP_IDS = 'Comp 1' 'OUTSIDE' TOP = 0.3, BOTTOM = 0, WIDTH = 1 FACE = 'FRONT' /
&VENT TYPE = 'MECHANICAL' ID = 'Exhaust' COMP_IDS = 'Comp 1', 'OUTSIDE' AREAS = 0.25, 0.25 HEIGHTS = -2.0, -2.0 FLOW = 0.5 ORIENTATIONS = 'HORIZONTAL', 'HORIZONTAL' /
&FIRE ID = 'F1' COMP_ID = 'Comp 1' FIRE_ID = 'F1_fire' LOCATION = 2.5, 2.5 /
&CHEM ID = 'F1_fire' CARBON = 1 HYDROGEN = 4 HEAT_OF_COMBUSTION = 50000 RADIATIVE_FRACTION = 0.35 HRR = 50 AREA = 0.2 SOOT_YIELD = 0.01 /
&TAIL /
