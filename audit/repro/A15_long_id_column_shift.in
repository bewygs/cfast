&HEAD VERSION = 7500, TITLE = 'Object id length check' /
!! Audit A15 - spreadsheet lookup truncates IDs to 50 characters (outputspreadsheet.f90:691, 699-700).
!! IDs of 55 characters for a room, fire, target and vent.
!! Expected: each CSV row has as many values as header fields.
!! Observed on master: compartments 69 headers / 31 values, devices 73/37, vents 19/10, walls 9/5; later values move under wrong headers.
&TIME SIMULATION = 60 PRINT = 30 SMOKEVIEW = 30 SPREADSHEET = 30 /
&INIT PRESSURE = 101325 RELATIVE_HUMIDITY = 50 INTERIOR_TEMPERATURE = 20 EXTERIOR_TEMPERATURE = 20 /
&MATL ID = 'CONCRETE' CONDUCTIVITY = 1.75 DENSITY = 2200 SPECIFIC_HEAT = 1, THICKNESS = 0.15 EMISSIVITY = 0.94 /
&COMP ID = 'Compartment_with_a_fifty_five_character_identifier_xxxx' DEPTH = 5 HEIGHT = 3 WIDTH = 5 CEILING_MATL_ID = 'CONCRETE' WALL_MATL_ID = 'CONCRETE' FLOOR_MATL_ID = 'CONCRETE' ORIGIN = 0, 0, 0 /
&COMP ID = 'Comp 2' DEPTH = 5 HEIGHT = 3 WIDTH = 5 CEILING_MATL_ID = 'CONCRETE' WALL_MATL_ID = 'CONCRETE' FLOOR_MATL_ID = 'CONCRETE' ORIGIN = 5, 0, 0 /
&VENT TYPE = 'WALL' ID = 'Wall_vent_with_a_fifty_five_character_identifier_xxxxxxx' COMP_IDS = 'Compartment_with_a_fifty_five_character_identifier_xxxx' 'OUTSIDE' TOP = 2, BOTTOM = 0, WIDTH = 1 FACE = 'FRONT' OFFSET = 2 /
&VENT TYPE = 'WALL' ID = 'WV2' COMP_IDS = 'Compartment_with_a_fifty_five_character_identifier_xxxx' 'Comp 2' TOP = 2, BOTTOM = 0, WIDTH = 1 FACE = 'RIGHT' OFFSET = 2 /
&FIRE ID = 'Fire_object_with_a_fifty_five_character_identifier_xxxx' COMP_ID = 'Compartment_with_a_fifty_five_character_identifier_xxxx', FIRE_ID = 'F1_Fire' LOCATION = 2.5, 2.5 /
&CHEM ID = 'F1_Fire' CARBON = 1 CHLORINE = 0 HYDROGEN = 4 NITROGEN = 0 OXYGEN = 0 HEAT_OF_COMBUSTION = 50000 RADIATIVE_FRACTION = 0.33 /
&TABL ID = 'F1_Fire' LABELS = 'TIME', 'HRR', 'HEIGHT', 'AREA', 'CO_YIELD', 'SOOT_YIELD', 'HCN_YIELD', 'HCL_YIELD', 'TRACE_YIELD' /
&TABL ID = 'F1_Fire', DATA = 0, 0, 0, 0.1, 0.01, 0.01, 0, 0, 0 /
&TABL ID = 'F1_Fire', DATA = 60, 100, 0, 0.1, 0.01, 0.01, 0, 0, 0 /
&DEVC ID = 'Target_device_with_a_fifty_five_char_identifier_xxxxxxx' COMP_ID = 'Compartment_with_a_fifty_five_character_identifier_xxxx' LOCATION = 2.2, 1.88, 2.34 TYPE = 'PLATE' MATL_ID = 'CONCRETE' NORMAL = 0, 0, 1 TEMPERATURE_DEPTH = 0.075 DEPTH_UNITS = 'M' /
&DEVC ID = 'Targ 2' COMP_ID = 'Comp 2' LOCATION = 2.2, 1.88, 2.34 TYPE = 'PLATE' MATL_ID = 'CONCRETE' NORMAL = 0, 0, 1 TEMPERATURE_DEPTH = 0.075 DEPTH_UNITS = 'M' /
&TAIL /
