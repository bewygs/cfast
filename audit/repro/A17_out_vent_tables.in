&HEAD VERSION = 7500, TITLE = 'Vent initial output check' /
!! Audit A17 - VENT CONNECTIONS and VENT RAMPS tables of the .out file misreport the inputs (output.f90:816-948).
!! Expected in .out: CF1 times 30/40 s and fractions 0/1; CF2 fractions 0.20/0.90; MV2 area 0.30 m2 and flow 0.05 m3/s; MV3 area 0.40 m2; ramps of WV1 and MV2 listed.
!! Observed on master: CF1 0.00/1.00/0.00/1.00; CF2 1.00/1.00; MV2 area 0.05, flow 0.30; MV3 area 0.00; only one ramp listed, under vent number 1.
!! The vents CSV confirms the real behavior (for example CFF_2_1_1 is 0 until 30 s).
&TIME SIMULATION = 60 PRINT = 30 SMOKEVIEW = 30 SPREADSHEET = 10 /
&INIT PRESSURE = 101325 RELATIVE_HUMIDITY = 50 INTERIOR_TEMPERATURE = 20 EXTERIOR_TEMPERATURE = 20 /
&MATL ID = 'CONCRETE' CONDUCTIVITY = 1.75 DENSITY = 2200 SPECIFIC_HEAT = 1, THICKNESS = 0.15 EMISSIVITY = 0.94 /
&COMP ID = 'Comp 1' DEPTH = 5 HEIGHT = 3 WIDTH = 5 CEILING_MATL_ID = 'CONCRETE' WALL_MATL_ID = 'CONCRETE' FLOOR_MATL_ID = 'CONCRETE' ORIGIN = 0, 0, 0 /
&COMP ID = 'Comp 2' DEPTH = 5 HEIGHT = 3 WIDTH = 5 CEILING_MATL_ID = 'CONCRETE' WALL_MATL_ID = 'CONCRETE' FLOOR_MATL_ID = 'CONCRETE' ORIGIN = 0, 0, 3 /
&VENT TYPE = 'WALL' ID = 'WV1' COMP_IDS = 'Comp 1' 'OUTSIDE' TOP = 2, BOTTOM = 0, WIDTH = 1 FACE = 'FRONT' OFFSET = 2
      CRITERION = 'TIME' T = 0, 10, 20 F = 0, 0.5, 1 /
&VENT TYPE = 'FLOOR' ID = 'CF1' COMP_IDS = 'Comp 2', 'Comp 1' AREA = 1, SHAPE = 'ROUND' CRITERION = 'TIME' T = 30, 40 F = 0, 1 OFFSETS = 2.5, 2.5 /
&VENT TYPE = 'CEILING' ID = 'CF2' COMP_IDS = 'OUTSIDE', 'Comp 2' AREA = 0.5, SHAPE = 'SQUARE' CRITERION = 'TEMPERATURE' SETPOINT = 100 DEVC_ID = 'Targ 1' PRE_FRACTION = 0.2 POST_FRACTION = 0.9 OFFSETS = 1, 1 /
&VENT TYPE = 'MECHANICAL' ID = 'MV1' COMP_IDS = 'OUTSIDE', 'Comp 1' AREAS = 0.25, 0.25 HEIGHTS = 2.75, 2.75 FLOW = 0.02 CUTOFFS = 200, 300 OFFSETS = 0, 4
      CRITERION = 'TIME' T = 30, 40 F = 0, 1 /
&VENT TYPE = 'MECHANICAL' ID = 'MV2' COMP_IDS = 'Comp 1', 'OUTSIDE' AREAS = 0.3, 0.3 HEIGHTS = 2.75, 2.75 FLOW = 0.05 CUTOFFS = 200, 300 OFFSETS = 5, 4
      CRITERION = 'TIME' T = 0, 10, 20 F = 0, 0.5, 1 /
&VENT TYPE = 'MECHANICAL' ID = 'MV3' COMP_IDS = 'Comp 2', 'OUTSIDE' AREAS = 0.4, 0.4 HEIGHTS = 2.75, 2.75 FLOW = 0.07 CUTOFFS = 200, 300 OFFSETS = 1, 4
      CRITERION = 'TEMPERATURE' SETPOINT = 100 DEVC_ID = 'Targ 1' PRE_FRACTION = 0.2 POST_FRACTION = 0.9 /
&FIRE ID = 'F1' COMP_ID = 'Comp 1', FIRE_ID = 'F1_Fire' LOCATION = 2.5, 2.5 /
&CHEM ID = 'F1_Fire' CARBON = 1 CHLORINE = 0 HYDROGEN = 4 NITROGEN = 0 OXYGEN = 0 HEAT_OF_COMBUSTION = 50000 RADIATIVE_FRACTION = 0.33 /
&TABL ID = 'F1_Fire' LABELS = 'TIME', 'HRR', 'HEIGHT', 'AREA', 'CO_YIELD', 'SOOT_YIELD', 'HCN_YIELD', 'HCL_YIELD', 'TRACE_YIELD' /
&TABL ID = 'F1_Fire', DATA = 0, 0, 0, 0.1, 0.01, 0.01, 0, 0, 0 /
&TABL ID = 'F1_Fire', DATA = 60, 100, 0, 0.1, 0.01, 0.01, 0, 0, 0 /
&DEVC ID = 'Targ 1' COMP_ID = 'Comp 1' LOCATION = 2.2, 1.88, 2.34 TYPE = 'PLATE' MATL_ID = 'CONCRETE' NORMAL = 0, 0, 1 TEMPERATURE_DEPTH = 0.075 DEPTH_UNITS = 'M' /
&TAIL /
